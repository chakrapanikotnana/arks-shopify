{%- doc -%}
  Product card layout styles. Kept in a standalone snippet so empty filtered grids
  can preload the styles before facets morph product cards into the section.

  @example
  {% render 'product-card-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-grid__card.product-grid__card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--product-card-gap);
    align-items: var(--product-card-alignment);
    text-decoration: none;
    color: var(--color, var(--color-foreground));
    padding-block: var(--padding-block-start) var(--padding-block-end);
    padding-inline: var(--padding-inline-start) var(--padding-inline-end);
    overflow: hidden;
  }

  .product-grid__card .group-block > * {
    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  /* Homepage and collection cards share one fixed content geometry. */
  :is(.product-grid__item, .resource-list__item) .product-card[data-card-context='collection'] {
    display: grid;
    height: 100%;
    min-width: 0;
    width: 100%;
  }

  .product-card[data-card-context='collection'] .product-grid__card {
    height: 100%;
    min-width: 0;
    width: 100%;
  }

  .product-card[data-card-context='collection'] [ref='productTitleLink'] .text-block {
    min-block-size: 1.3em;
    width: 100%;
  }

  .product-card[data-card-context='collection'] [ref='productTitleLink'] .text-block > :is(p, h1, h2, h3, h4, h5, h6) {
    display: block;
    font-weight: 700;
    margin: 0;
    overflow: hidden;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-card[data-card-context='collection'] product-price {
    container-type: inline-size;
    display: block;
    margin-block-start: auto;
    min-block-size: 2.75rem;
    min-width: 0;
    width: 100%;
  }

  .product-card[data-card-context='collection'] product-price [ref='priceContainer'] {
    min-block-size: inherit;
    min-width: 0;
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }
{% endstylesheet %}
