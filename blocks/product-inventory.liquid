

{%- liquid
  assign block_settings = block.settings
  assign variant = closest.product.selected_or_first_available_variant
  if variant.inventory_management == 'shopify'
    assign inventory_managed = true
  endif
  assign inventory_quantity = variant.inventory_quantity
  assign inventory_policy = variant.inventory_policy
  assign threshold = block_settings.inventory_threshold
  assign is_main_product_inventory = false
  if template.name == 'product' and closest.product.id == product.id
    assign is_main_product_inventory = true
    assign available_m2 = closest.product.metafields.arks.avaialable
  endif

  if inventory_managed
    if inventory_quantity > 0
      if inventory_quantity <= threshold
        assign status = 'low'
        assign show_quantity = block_settings.show_inventory_quantity
        if show_quantity == false
          assign translation_key = 'content.inventory_low_stock'
        endif
      else
        assign status = 'in_stock'
        assign translation_key = 'content.inventory_in_stock'
      endif
    else
      if inventory_policy == 'continue'
        assign status = 'in_stock'
        assign translation_key = 'content.inventory_in_stock'
      else
        assign status = 'out_of_stock'
        assign translation_key = 'content.inventory_out_of_stock'
      endif
    endif
  else
    if is_main_product_inventory
      if variant.available
        assign status = 'in_stock'
        assign translation_key = 'content.inventory_in_stock'
      else
        assign status = 'out_of_stock'
        assign translation_key = 'content.inventory_out_of_stock'
      endif
    else
      if closest.product.selected_or_first_available_variant != null
        assign status = 'in_stock'
        assign translation_key = 'content.inventory_in_stock'
      else
        assign status = 'out_of_stock'
        assign translation_key = 'content.inventory_out_of_stock'
      endif
    endif
  endif

  if is_main_product_inventory and status == 'low'
    assign translation_key = 'content.inventory_in_stock'
  endif
-%}

{% if block_settings.text_color != blank %}
  {% style %}
    .product-inventory-{{ block.id }} {
      color: {{ block_settings.text_color }};
    }
  {% endstyle %}
{% endif %}

<product-inventory
  class="
    product-inventory product-inventory-{{ block.id }} spacing-style
    {% if block_settings.type_preset != '' %}{{ block_settings.type_preset }}{% endif%}
  "
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
  data-product-id="{{ product.id }}"
>
  {% if is_main_product_inventory %}
    {%- liquid
      assign show_tile_count = false
      assign show_available_m2 = false
      if inventory_managed and inventory_quantity > 0
        assign show_tile_count = true
        assign show_available_m2 = true
      elsif inventory_managed != true and status != 'out_of_stock'
        assign show_available_m2 = true
      endif

      if available_m2.value != blank
        assign available_m2_rounded = available_m2.value | times: 1.0 | round: 2
        assign available_m2_parts = available_m2_rounded | split: '.'
        capture formatted_available_m2
          echo available_m2_parts[0]
          echo '.'
          if available_m2_parts.size == 1
            echo '00'
          elsif available_m2_parts[1].size == 1
            echo available_m2_parts[1]
            echo '0'
          else
            echo available_m2_parts[1]
          endif
        endcapture
      endif
    -%}

    <span class="product-inventory__status pdp-stock">
      <span
        class="svg-wrapper product-inventory__icon product-inventory__icon-{{ status }}"
        aria-hidden="true"
      >
        {{ 'icon-inventory.svg' | inline_asset_content }}
      </span>
      <span
        class="pdp-stock__items"
        id="Inventory-{{ section.id }}"
        role="status"
        aria-label="{{ 'accessibility.inventory_status' | t }}"
      >
        <strong class="pdp-stock__status">{{ translation_key | t }}</strong>
        {% if status != 'out_of_stock' and show_tile_count %}
          <span class="pdp-stock__separator" aria-hidden="true">|</span>
          <span>Available tiles: {{ inventory_quantity }}</span>
        {% endif %}
        {% if show_available_m2 and formatted_available_m2 != blank %}
          <span class="pdp-stock__separator" aria-hidden="true">|</span>
          <span>Available m²: {{ formatted_available_m2 }}</span>
        {% endif %}
      </span>
    </span>
  {% else %}
    <span class="product-inventory__status">
      <span
        class="svg-wrapper product-inventory__icon product-inventory__icon-{{ status }}"
      >
        {{ 'icon-inventory.svg' | inline_asset_content }}
      </span>
      <span
        class="product-inventory__text"
        id="Inventory-{{ section.id }}"
        role="status"
        aria-label="{{ 'accessibility.inventory_status' | t }}"
      >
        {%- if show_quantity -%}
          {{ 'content.inventory_low_stock_show_count' | t: count: inventory_quantity }}
        {%- else -%}
          {{- translation_key | t -}}
        {%- endif -%}
      </span>
    </span>
  {% endif %}
</product-inventory>

{% stylesheet %}
  .product-inventory__status {
    display: flex;
    align-items: center;
    font-size: var(--font-paragraph--size);
    line-height: var(--font-paragraph--line-height);
    gap: var(--padding-xs);
  }

  .product-inventory__icon,
  .product-inventory__icon svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }

  .product-inventory__icon-low {
    color: var(--color-lowstock);
  }

  .product-inventory__icon-in_stock {
    color: var(--color-instock);
  }

  .product-inventory__icon-out_of_stock {
    color: var(--color-outofstock);
  }

  .product-inventory__icon circle:first-of-type {
    opacity: 0.3;
  }

  .pdp-stock,
  .pdp-stock__items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--padding-xs);
  }

  .pdp-stock__status {
    font-weight: 600;
  }

  @media screen and (max-width: 374px) {
    .pdp-stock__separator {
      display: none;
    }

    .pdp-stock__items {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--padding-3xs);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_inventory",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_inventory"
    },
    {
      "type": "range",
      "id": "inventory_threshold",
      "label": "t:settings.inventory_threshold",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_inventory_quantity",
      "label": "t:settings.show_inventory_quantity",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_inventory",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
